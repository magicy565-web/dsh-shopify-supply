# in-memory (default) does not need a model key.
# AGENT_RUNTIME=dsh requires a key and the pinned DeepSeek Harness packages.
AGENT_RUNTIME=dsh
AGENT_GATEWAY_PORT=8787
WEB_ORIGIN=http://127.0.0.1:3000
CATALOG_DATA_FILE=
PROCUREMENT_DATA_FILE=
CATALOG_API_URL=http://127.0.0.1:8787
CATALOG_IMPORT_ENABLED=false

# When set, catalog and procurement storage switch from local JSON to PostgreSQL.
# pnpm catalog:seed and the gateway then use this adapter.
DATABASE_URL=
DATABASE_POOL_SIZE=10

# Used only when AGENT_RUNTIME=dsh
DEEPSEEK_API_KEY=
# OpenAI-compatible gateway base URL. FastAIToken commonly exposes /v1/chat/completions.
DEEPSEEK_BASE_URL=https://www.fastaitoken.com/v1
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash

# Shared by the gateway, DSH plugins, and the approval bridge. Generated at boot if unset.
AGENT_INTERNAL_TOKEN=
# Operator identity recorded on agent-approved quote requests.
AGENT_OPERATOR_ID=
# 0 disables. Defaults: approval 10m, idle subprocess recycle 15m.
AGENT_APPROVAL_TIMEOUT_MS=
AGENT_SESSION_IDLE_TTL_MS=
