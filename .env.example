# in-memory (default) does not need a model key.
# AGENT_RUNTIME=dsh requires a key and the pinned DeepSeek Harness packages.
AGENT_RUNTIME=in-memory
AGENT_GATEWAY_PORT=8787
WEB_ORIGIN=http://127.0.0.1:3000
CATALOG_DATA_FILE=
PROCUREMENT_DATA_FILE=
CATALOG_API_URL=http://127.0.0.1:8787
CATALOG_IMPORT_ENABLED=false

# When set, catalog and procurement storage switch from local JSON to PostgreSQL.
# pnpm catalog:seed and the gateway then use this adapter.
DATABASE_URL=
DATABASE_POOL_SIZE=10

# Used only when AGENT_RUNTIME=dsh
DEEPSEEK_API_KEY=
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
